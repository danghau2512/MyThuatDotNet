@model MyThuatShop.ViewModels.Auth.ForgotPasswordVm
@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = "_Layout";
}

<style>
    .container { width: 1200px; margin: auto; }

    .main {
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(to left, #2659F3, #09BCE4);
    }

    .box {
        background-color: rgba(0, 0, 0, 0.4);
        padding: 45px 45px;
        box-sizing: border-box;
        overflow: hidden;
        position: relative;
        transition: 0.5s ease;
        flex-wrap: wrap;
        border-radius: 10px;
        width: 460px;
        height: 480px;
    }

    h2 {
        color: white;
        text-align: center;
        text-transform: uppercase;
        margin-bottom: 10px;
        font-weight: 700;
    }

    p { color: white; text-align: center; margin-bottom: 20px; }

    .form-email .form-1 input {
        width: 100%;
        border: none;
        border-bottom: 1px solid #ccc;
        outline: none;
        font-size: 14px;
        background: none;
        color: white;
        border-radius: 8px;
        padding: 10px;
        transition: border-color 0.3s;
    }

    .form-email .form-1 input::placeholder { color: #ccc5c5; }

    .btn-lay-mk {
        width: 100%;
        background-color: #F5DF4D;
        padding: 10px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        margin-bottom: 5px;
        margin-top: 15px;
        color: #343A40;
        font-size: 1rem;
        font-weight: bold;
    }

    .btn-lay-mk:hover { transform: scale(1.05); }

    .quay-lai-dang-nhap { text-align: center; margin-bottom: 15px; }
    .link-quay-lai { color: white; text-decoration: none; }
    .link-quay-lai:hover { color: #6C785B; }

    .link-dki { color: #FFC107; text-decoration: none; }
    .link-dki:hover { color: #6C785B; }

    .chuataikhoan { color: white; text-align: center; }

    .btn-login-gg { display: flex; justify-content: space-between; }

    .btn-gg {
        background-color: #DE3F32;
        color: white;
        border: none;
        border-radius: 5px;
        padding: 10px 50px;
        margin-top: 10px;
        cursor: pointer;
        width: 100%;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }
</style>

<div class="main">
    <div class="box">
        <h2>ĐẶT LẠI MẬT KHẨU</h2>
        <p>Chúng tôi sẽ gửi cho bạn một email để kích hoạt việc đặt lại mật khẩu</p>

        <form asp-controller="Account" asp-action="ForgotPassword" class="form-email" method="post">
            @Html.AntiForgeryToken()

            <div class="form-1">
                <input asp-for="Email" id="email" type="email" placeholder="Email" required
                       pattern="^[A-Za-z0-9._%+-]+@@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$"
                       title="Email phải đúng định dạng, ví dụ: ten@@gmail.com" />
                <span id="email-error" style="color:#FFD700; font-size:14px;"></span>
                <span asp-validation-for="Email" style="color:#FFD700; font-size:14px;"></span>
            </div>

            <p style="color: red; margin-top: 10px">@ViewBag.Error</p>
            <p style="color: #00ff00; margin-top: 10px">@ViewBag.Success</p>

            <button type="submit" class="btn-lay-mk">Lấy lại mật khẩu</button>

            <div class="quay-lai-dang-nhap">
                <a asp-controller="Account" asp-action="Login" class="link-quay-lai">Quay lại</a>
            </div>

            <div class="chuataikhoan">
                Bạn chưa có tài khoản
                <a asp-controller="Account" asp-action="Register" class="link-dki">Đăng ký tại đây</a>
            </div>

            <div class="btn-login-gg">
                <a class="btn-gg"
                   asp-controller="Account"
                   asp-action="GoogleLogin"
                   asp-route-returnUrl="@Url.Action("Index","Home")">
                    <i class="fa-brands fa-google"></i> Google
                </a>
            </div>
        </form>
    </div>
</div>

<partial name="_ValidationScriptsPartial" />

<script>
    // check error email (giống JSP)
    const emailInput = document.getElementById("email");
    const emailError = document.getElementById("email-error");
    const emailRegex = /^[A-Za-z0-9._%+-]+@@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/;

    emailInput.addEventListener("input", () => {
        const email = emailInput.value.trim();
        if (email.length === 0) { emailError.textContent = ""; return; }
        emailError.textContent = emailRegex.test(email) ? "" : "Email không hợp lệ (vd: ten@@gmail.com)";
    });
</script>
