@model MyThuatShop.ViewModels.Auth.LoginVm
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .main {
            margin: 0;
            padding: 30px 0 0;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: calc(100vh - 80px);
            background-color: #1E76EF;
        }

        .login-box {
            background-color: rgba(0, 0, 0, 0.4);
            border-radius: 10px;
            width: 460px;
            max-width: 92vw;
            padding: 45px 45px;
            box-sizing: border-box;
            margin-top: 0px;
        }

        .login-title {
            color: white;
            text-align: center;
            text-transform: uppercase;
            margin-bottom: 30px;
            font-weight: 700;
        }

        .form-1 {
            margin-top: 8px;
        }

            .form-1 label {
                display: block;
                color: white;
                margin-bottom: 6px;
            }

            .form-1 input {
                width: 100%;
                padding: 10px 0;
                background: transparent;
                border: none;
                border-bottom: 1px solid #ffffff;
                color: #fff;
                outline: none;
                box-sizing: border-box;
            }

                .form-1 input::placeholder {
                    color: #a0a0a0;
                }

        .field-error {
            display: block;
            color: #FFD700;
            font-size: 14px;
            margin-top: 6px;
        }

        .server-error {
            color: red;
            margin-top: 8px;
        }

        .forgot-password {
            text-align: center;
            margin: 18px 0 14px 0;
        }

            .forgot-password a {
                color: #ffc107;
                text-decoration: none;
            }

                .forgot-password a:hover {
                    color: #6C785B;
                }

        .btn-login {
            width: 100%;
            background-color: #F5DF4D;
            padding: 10px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 10px;
            margin-bottom: 12px;
            color: #343A40;
            font-weight: 600;
        }

        .chuataikhoan {
            color: white;
            text-align: center;
            margin-top: 8px;
            margin-bottom: 14px;
        }

        .link-dki {
            color: #FFC107;
            text-decoration: none;
            font-weight: 600;
            margin-left: 4px;
        }

            .link-dki:hover {
                color: #6C785B;
            }

        .btn-gg {
            background-color: #DE3F32;
            color: white;
            border: none;
            border-radius: 5px;
            padding: 10px;
            cursor: pointer;
            width: 100%;
            display: block;
            text-align: center;
            text-decoration: none;
            font-weight: 600;
            margin-top: 10px;
        }

            .btn-gg i {
                margin-right: 10px;
            }
    </style>
}

<div class="main">
    <div class="login-box">
        <h4 class="login-title">ĐĂNG NHẬP</h4>

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

            <input type="hidden" asp-for="ReturnUrl" />

            <div class="form-1">
                <label asp-for="Email">Email*</label>
                <input asp-for="Email" type="text" id="email" placeholder="Nhập Email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-1">
                <label asp-for="Password">Mật khẩu*</label>
                <input asp-for="Password" type="password" id="Mk" placeholder="Nhập mật khẩu" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <!-- lỗi server giống ${error} -->
            <div asp-validation-summary="ModelOnly" class="server-error"></div>

            <div class="forgot-password">
                <p style="color:white;margin:0;">
                    Quên mật khẩu? Nhấn vào <a href="#">đây</a>
                </p>
            </div>

            <button type="submit" class="btn-login">Đăng Nhập</button>

            <div class="chuataikhoan">
                Bạn chưa có tài khoản
                <a asp-controller="Account" asp-action="Register" class="link-dki">Đăng ký tại đây</a>
            </div>

            <!-- ✅ Google login cũng giữ returnUrl -->
            <a class="btn-gg"
               asp-controller="Account"
               asp-action="GoogleLogin"
               asp-route-returnUrl="@Model.ReturnUrl">
                <i class="fa-brands fa-google"></i> Google
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @* Popup hết session *@
    @if (ViewBag.SessionExpired == true)
    {
        <script>
            Swal.fire({
                icon: 'info',
                title: 'Phiên đăng nhập đã hết hạn',
                text: 'Vui lòng đăng nhập lại để tiếp tục sử dụng hệ thống.',
                confirmButtonText: 'Đóng',
                confirmButtonColor: '#f5d64e'
            });
        </script>
    }

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Thành công',
                text: 'Bạn đã đăng ký tài khoản thành công, hãy đăng nhập để tiếp tục mua hàng nhé!',
                confirmButtonText: 'OK'
            });
        </script>
    }

    <script>
        
        document.querySelector('input[name="Email"]')
            ?.addEventListener('input', function () {
                if (window.$ && $(this).valid) $(this).valid();
            });
    </script>
}
