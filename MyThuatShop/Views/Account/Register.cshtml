@model MyThuatShop.ViewModels.Auth.RegisterVm
@{
    ViewData["Title"] = "Đăng ký";
    Layout = "_Layout";
}

<style>
    .container { width: 1200px; margin: auto; }

    /* GIỐNG JSP */
    .main {
        margin: 0;
        padding: 30px 0 0;
        display: flex;
        justify-content: center;
        align-items: flex-start;
        min-height: calc(100vh - 80px);
        background-color: #1E76EF;
       
    }

    .register-box {
        background-color: rgba(0, 0, 0, 0.4);
        padding: 40px 50px;
        transition: 0.5s ease;
        width: 530px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
        border-radius: 10px;
    }

    h2 {
        color: white;
        text-align: center;
        text-transform: uppercase;
        margin-bottom: 15px;
    }

    .infor {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px 20px;
        margin-bottom: 20px;
    }

    .infor .tt-chitiet label {
        font-size: 17px;
        font-weight: normal;
        color: white;
    }

    .infor .tt-chitiet input {
        width: 100%;
        border: none;
        border-bottom: 1px solid #ccc;
        outline: none;
        font-size: 14px;
        background: none;
        color: white;
        border-radius: 8px;
        padding: 10px;
        transition: border-color 0.3s;
    }

    .infor .tt-chitiet input::placeholder {
        color: #B0B0B0;
    }

    .btn-DangKy {
        background: linear-gradient(90deg, #FFD700, #FFC107);
        width: 100%;
        padding: 10px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        margin-bottom: 15px;
        color: #000;
        font-weight: bold;
        transition: 0.3s;
    }

    .btn-DangKy:hover { transform: scale(1.05); }

    .text-login {
        margin-top: 16px;
        text-align: center;
        color: #ffffff;
        font-size: 16px;
    }

    .text-login a {
        color: #FFD700;
        text-decoration: none;
        font-weight: 500;
    }

    .text-login a:hover { text-decoration: underline; }

    .btn-dang-nhap-tt {
        display: flex;
        justify-content: space-between;
    }

    .btn-gg {
        background-color: #DE3F32;
        color: white;
        border: none;
        border-radius: 5px;
        padding: 10px 80px;
        margin-left: 27%;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .field-warning {
        color: #FFD700;
        font-size: 14px;
        display: block;
        margin-top: 6px;
    }

    .server-error {
        color: red;
        padding: 10px;
    }
</style>

<div class="main">
    <div class="register-box">
        <h2>Đăng Ký</h2>

        <form asp-controller="Account" asp-action="Register" method="post" class="infor" id="registerForm">
            @Html.AntiForgeryToken()

            <div class="tt-chitiet" style="grid-column: span 2;">
                <label for="Ho">Họ và Tên:</label>
                <input asp-for="FullName" id="Ho" placeholder="Họ và Tên" required />
                <span asp-validation-for="FullName" class="field-warning"></span>
            </div>

            <div class="tt-chitiet">
                <label for="email">Email cá nhân:</label>
                <input asp-for="Email"
                       id="email"
                       type="email"
                       placeholder="Email cá nhân"
                       required
                       pattern="^[A-Za-z0-9._%+-]+@@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$"
                       title="Email phải đúng định dạng, ví dụ: ten@@gmail.com"
                       />
                <span id="email-error" class="field-warning"></span>
                <span asp-validation-for="Email" class="field-warning"></span>
            </div>

            <div class="tt-chitiet">
                <label for="sdt">Số điện thoại:</label>
                <input asp-for="PhoneNumber"
                       id="sdt"
                       type="tel"
                       required
                       maxlength="10"
                       placeholder="Số điện thoại"
                       pattern="^0\d{9}$"
                       title="Số điện thoại phải gồm 10 chữ số và bắt đầu bằng số 0" />
                <span id="phonerror" class="field-warning"></span>
                <span asp-validation-for="PhoneNumber" class="field-warning"></span>
            </div>

            <div class="tt-chitiet" style="grid-column: span 2; position: relative;">
                <label for="Mk">Mật khẩu:</label>
                <input asp-for="Password"
                       id="Mk"
                       type="password"
                       placeholder="Mật khẩu"
                       required
                       minlength="8"
                       pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*[^A-Za-z0-9]).{8,}$"
                       title="Mật khẩu có ít nhất 8 kí tự gồm chữ hoa, chữ thường và các kí tự đặc biệt." />
                <span id="pwerror" class="field-warning"></span>
                <span asp-validation-for="Password" class="field-warning"></span>

                @* Lỗi server *@
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="server-error">
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                }
            </div>

            @* Không hiện “nhập lại mật khẩu”, nhưng nếu RegisterVm có ConfirmPassword (cách A) thì vẫn gửi hidden *@
            <input asp-for="ConfirmPassword" type="hidden" id="ConfirmPassword" />

            <button type="submit" class="btn-DangKy" style="grid-column: span 2;">
                Đăng ký
            </button>
        </form>

        <p class="text-login">
            Bạn đã có tài khoản
            <a asp-controller="Account" asp-action="Login">Đăng nhập tại đây</a>
        </p>

        <div class="btn-dang-nhap-tt">
            <a class="btn-gg"
               asp-controller="Account"
               asp-action="GoogleLogin"
               asp-route-returnUrl="@Url.Action("Index","Home")"
               style="text-align: center">
                <i class="fa-brands fa-google"></i>
                Google
            </a>
        </div>
    </div>
</div>

<partial name="_ValidationScriptsPartial" />

<script>
    // set ConfirmPassword = Password để pass [Compare] (cách A)
    document.getElementById("registerForm").addEventListener("submit", function () {
        const pwd = document.getElementById("Mk");
        const confirm = document.getElementById("ConfirmPassword");
        if (pwd && confirm) confirm.value = pwd.value;
    });

    // check sdt
    const phoneInput = document.getElementById("sdt");
    const phoneError = document.getElementById("phonerror");
    phoneInput.addEventListener("input", () => {
        phoneInput.value = phoneInput.value.replace(/\D/g, "").slice(0, 10);
        const ok = /^0\d{9}$/.test(phoneInput.value);
        phoneError.textContent = ok || phoneInput.value.length === 0
            ? ""
            : "SĐT không hợp lệ (vd: 0912345678)";
    });

    // check mk
    const passInput = document.getElementById("Mk");
    const passError = document.getElementById("pwerror");
    passInput.addEventListener("input", () => {
        const pass = passInput.value;
        const okLength = pass.length >= 8;
        const okLower  = /[a-z]/.test(pass);
        const okUpper  = /[A-Z]/.test(pass);
        const okSpecial = /[^A-Za-z0-9]/.test(pass);

        passError.textContent = (okLength && okLower && okUpper && okSpecial)
            ? ""
            : "Mật khẩu có ít nhất 8 ký tự, có chữ hoa, chữ thường và ký tự đặc biệt.";
    });

    // check email
    const emailInput = document.getElementById("email");
    const emailError = document.getElementById("email-error");
    const emailRegex = /^[A-Za-z0-9._%+-]+@@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$/;
    emailInput.addEventListener("input", () => {
        const email = emailInput.value.trim();
        if (email.length === 0) { emailError.textContent = ""; return; }
        emailError.textContent = emailRegex.test(email) ? "" : "Email không hợp lệ (vd: ten@gmail.com)";
    });
</script>
