@model MyThuatShop.ViewModels.Auth.RegisterVm
@{
    ViewData["Title"] = "Đăng ký";
    Layout = "_Layout";
}

@section Styles {
    <style>
        /* ===== Header + Footer (giữ nguyên theo bạn) ===== */
        /* Lưu ý: Mình không dùng class .container nữa để tránh đụng Bootstrap/Layout */

        #header-trang-chu {
            background-color: var(--color-main);
            display: flex;
            align-items: center;
            position: fixed;
            z-index: 999;
            width: 100%;
            top: 0;
            left: 0;
        }

            #header-trang-chu .logo-trang-chu {
                margin-left: 50px;
                margin-right: 50px;
                margin-top: 25px;
                margin-bottom: 25px;
            }

                #header-trang-chu .logo-trang-chu img {
                    background-color: transparent;
                    width: 200px;
                    height: 100%;
                }

            #header-trang-chu .tim-kiem-san-pham {
                position: relative;
                display: flex;
            }

                #header-trang-chu .tim-kiem-san-pham input {
                    padding: 10px 15px;
                    width: 600px;
                    border-radius: 10px;
                    border: none;
                }

                #header-trang-chu .tim-kiem-san-pham i {
                    position: absolute;
                    right: 0;
                    width: 50px;
                    height: 100%;
                    background-color: #0b234d;
                    line-height: 40px;
                    cursor: pointer;
                    color: white;
                    border-top-right-radius: 10px;
                    border-bottom-right-radius: 10px;
                    text-align: center;
                }

            #header-trang-chu .header-contact {
                display: flex;
                align-items: center;
                margin-left: 100px;
                margin-right: 50px;
                cursor: pointer;
            }

                #header-trang-chu .header-contact i {
                    width: 30px;
                    height: 30px;
                    border-radius: 50%;
                    background-color: #0b234d;
                    line-height: 30px;
                    color: white;
                    text-align: center;
                }

                #header-trang-chu .header-contact .contact {
                    margin-left: 15px;
                }

                    #header-trang-chu .header-contact .contact .contact-phone-number {
                        color: white;
                        font-weight: 600;
                        font-size: 18px;
                    }

                    #header-trang-chu .header-contact .contact .contact-phone-help {
                        color: white;
                        font-size: 16px;
                    }

            #header-trang-chu .header-dangnhap-dangki {
                display: flex;
                align-items: center;
                cursor: pointer;
                margin-right: 50px;
            }

                #header-trang-chu .header-dangnhap-dangki i {
                    width: 30px;
                    height: 30px;
                    border-radius: 50%;
                    background-color: #0b234d;
                    line-height: 30px;
                    color: white;
                    text-align: center;
                }

                #header-trang-chu .header-dangnhap-dangki .dangnhap-dangki {
                    margin-left: 15px;
                }

                    #header-trang-chu .header-dangnhap-dangki .dangnhap-dangki .dangnhap {
                        color: white;
                        font-weight: 600;
                        font-size: 18px;
                    }

                    #header-trang-chu .header-dangnhap-dangki .dangnhap-dangki .dangki {
                        color: white;
                        font-size: 16px;
                    }

            #header-trang-chu .header-giohang {
                font-size: 25px;
                color: white;
                position: relative;
                cursor: pointer;
                margin-right: 20px;
            }

                #header-trang-chu .header-giohang::after {
                    display: inline-flex;
                    content: "0";
                    width: 20px;
                    height: 20px;
                    left: 20px;
                    bottom: 15px;
                    justify-content: center;
                    align-items: center;
                    font-size: 15px;
                    background-color: red;
                    position: absolute;
                    border-radius: 50%;
                }

        /* ===== Trang Register: CARD như hình 2 ===== */
        .main {
            margin: 0;
            padding: 140px 16px 40px; /* chừa header fixed */
            display: flex;
            justify-content: center;
            align-items: flex-start; /* card nằm dưới header */
            min-height: 100vh;
            background-color: #1E76EF;
        }

        /* KHÔNG dùng .container để tránh đụng layout */
        .register-card {
            width: 500px; /* giống hình 2 */
            max-width: 100%;
            background-color: rgba(0, 0, 0, 0.4);
            padding: 40px 50px;
            border-radius: 12px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
        }

        h2 {
            color: white;
            text-align: center;
            text-transform: uppercase;
            margin-bottom: 15px;
        }

        .infor {
            width: 100%;
            max-width: 680px; /* input vừa như hình 2 */
            margin: 0 auto 20px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px 20px;
        }

            .infor .tt-chitiet label {
                font-size: 17px;
                font-weight: normal;
                color: white;
                display: block;
                margin-bottom: 6px;
            }

            .infor .tt-chitiet input {
                width: 100%;
                border: none;
                border-bottom: 1px solid #ccc;
                outline: none;
                font-size: 14px;
                background: none;
                border-radius: 8px;
                padding: 10px;
                color: #fff;
                transition: border-color 0.3s;
            }

                .infor .tt-chitiet input::placeholder {
                    color: #B0B0B0;
                }

        .btn-DangKy {
            background: linear-gradient(90deg, #FFD700, #FFC107);
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            margin-bottom: 15px;
            color: #000;
            font-weight: bold;
            transition: 0.3s;
        }

            .btn-DangKy:hover {
                transform: scale(1.02);
            }

        .text-login {
            margin-top: 16px;
            text-align: center;
            color: #ffffff;
            font-size: 16px;
        }

            .text-login a {
                color: #FFD700;
                text-decoration: none;
                font-weight: 500;
            }

                .text-login a:hover {
                    text-decoration: underline;
                }

        .btn-dang-nhap-tt {
            display: flex;
            justify-content: center;
        }

        .btn-gg {
            background-color: #DE3F32;
            border: none;
            border-radius: 8px;
            padding: 10px 18px;
            font-size: 14px;
            color: white;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 220px;
        }

        /* responsive nhỏ */
        @@media (max-width: 600px) {
            .register-card {
                padding: 24px 18px;
            }

            .infor {
                grid-template-columns: 1fr;
                max-width: 100%;
            }
        }
    </style>
}

<header id="header-trang-chu" class="trang-chu">
    <div class="logo-trang-chu">
        <a href="index.html">
            <img src="UI/assets/images/logo/logo.png" alt />
        </a>
    </div>
    <form class="tim-kiem-san-pham">
        <input type="text" placeholder="Tìm kiếm sản phẩm..." />
        <i class="fa-solid fa-magnifying-glass"></i>
    </form>
    <div class="header-contact">
        <i class="fa-solid fa-phone"></i>
        <div class="contact">
            <div class="contact-phone-number">1900 866 819</div>
            <div class="contact-phone-help">Hỗ trợ khách hàng</div>
        </div>
    </div>
    <div class="header-dangnhap-dangki">
        <i class="fa-solid fa-user"></i>
        <div class="dangnhap-dangki">
            <div class="dangnhap">Đăng nhập</div>
            <div class="dangki">Đăng kí</div>
        </div>
    </div>
    <div class="header-giohang">
        <i class="fa-solid fa-bag-shopping"></i>
    </div>
</header>

<div class="main">
    <div class="register-card">
        <h2>Đăng Ký</h2>
        <div asp-validation-summary="All" style="color:#FFD700; font-size:14px; margin-bottom:10px;"></div>

        <form asp-controller="Account" asp-action="Register" method="post" class="infor">
            @Html.AntiForgeryToken()

            <div class="tt-chitiet" style="grid-column: span 2;">
                <label asp-for="FullName">Họ và Tên:</label>
                <input asp-for="FullName" type="text" placeholder="Họ và Tên" required />
                <span asp-validation-for="FullName" style="color:#FFD700; font-size:14px;"></span>
            </div>

            <div class="tt-chitiet">
                <label asp-for="Email">Email cá nhân:</label>
                <input asp-for="Email" type="email" placeholder="Email cá nhân" required />
                <span asp-validation-for="Email" style="color:#FFD700; font-size:14px;"></span>
            </div>

            <div class="tt-chitiet">
                <label asp-for="PhoneNumber">Số điện thoại:</label>
                <input asp-for="PhoneNumber" type="text" placeholder="Số điện thoại" />
                <span asp-validation-for="PhoneNumber" style="color:#FFD700; font-size:14px;"></span>
            </div>

            <div class="tt-chitiet" style="grid-column: span 2;">
                <label asp-for="Password">Mật khẩu:</label>
                <input asp-for="Password" type="password" placeholder="Mật khẩu" required />
                <span asp-validation-for="Password" style="color:#FFD700; font-size:14px;"></span>
            </div>
            <button type="submit" class="btn-DangKy" style="grid-column: span 2;">
                Đăng ký
            </button>
        </form>

        <p class="text-login">
            Bạn đã có tài khoản
            <a asp-controller="Account" asp-action="Login">Đăng nhập tại đây</a>
        </p>

        <div class="btn-dang-nhap-tt">
            <button type="button" class="btn-gg">
                <i class="fa-brands fa-google"></i>Google
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
