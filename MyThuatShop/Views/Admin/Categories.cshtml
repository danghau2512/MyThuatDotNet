@model List<MyThuatShop.Dtos.Admin.AdminCategoryDto>

@{
    ViewData["Title"] = "Quản lý danh mục";
    ViewData["ActiveMenu"] = "categories";
    // Nếu bạn đã có Views/Admin/_ViewStart.cshtml trỏ layout admin thì không cần Layout ở đây.
    // Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <!-- DataTables CSS (để chắc chắn chạy) -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />

    <style>
        /* ===== Layout right ===== */
        #main .right .container {
            display: flex;
            flex-direction: column;
            width: calc(100% - 100px);
            margin: 20px auto 0 auto;
        }

        .list-container {
            width: 95%;
            margin: 30px auto;
            background: #fff;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,.1);
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .btn-add {
            background: #2659F5;
            color: #fff;
            border: none;
            padding: 8px 12px;
            border-radius: 5px;
            cursor: pointer;
        }

            .btn-add:hover {
                background: #17479D;
            }

        /* ===== Table ===== */
        table.category-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

            table.category-table th {
                background: #2659F5;
                color: #fff;
                padding: 12px;
                font-size: 14px;
            }

            table.category-table td {
                padding: 12px;
                background: #fafafa;
                border-bottom: 1px solid #ddd;
                border-left: 1px solid #ddd;
                border-right: 1px solid #ddd;
            }

            table.category-table tr:nth-child(even) td {
                background: #f0f0f0;
            }

        .thumb {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #ddd;
        }

        .col-thumb {
            text-align: center;
            width: 90px;
        }

        /* ===== Buttons ===== */
        .btn-icon {
            color: #fff;
            padding: 8px 12px;
            border-radius: 5px;
            cursor: pointer;
            margin-right: 5px;
            border: none;
        }

        .btn-edit {
            background: #FFC107;
            color: #000;
        }

        .btn-lock {
            background: #DC3545;
        }

        .btn-unlock {
            background: #FFC107;
            color: #000;
        }

        .btn-icon:hover {
            opacity: .85;
        }

        /* ===== Badge ===== */
        .badge-active {
            color: #28a745;
            font-weight: 600;
        }

        .badge-inactive {
            color: #dc3545;
            font-weight: 600;
        }

        /* ===== DataTables ===== */
        .dataTables_wrapper {
            width: 100%;
            margin-top: 10px;
        }

        .dataTables_filter input,
        .dataTables_length select {
            padding: 6px 10px;
            border-radius: 6px;
            border: 1px solid #ddd;
            outline: none;
        }

        .dataTables_filter {
            margin-bottom: 10px;
        }

        .dataTables_paginate .paginate_button {
            padding: 6px 10px !important;
            border-radius: 6px !important;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background: #17479D !important;
            color: #fff !important;
            border: 1px solid #17479D !important;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background: #17479D !important;
            color: #fff !important;
            border: 1px solid #17479D !important;
        }

        /* ===== Modal ===== */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,.5);
            justify-content: center;
            align-items: center;
            z-index: 999;
            padding: 20px;
            overflow-y: auto;
        }

        .modal-content {
            background: #fff;
            padding: 25px;
            width: 600px;
            border-radius: 10px;
            box-shadow: 0 2px 10px rgba(0,0,0,.2);
            max-height: 90vh;
            overflow-y: auto;
            animation: fadeIn .2s ease;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: scale(.95);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .modal-content label {
            display: block;
            margin-top: 10px;
            font-size: 14px;
            color: #444;
        }

        .modal-content input {
            width: 100%;
            padding: 8px;
            margin-top: 4px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }

        .modal-buttons {
            display: flex;
            justify-content: flex-end;
            margin-top: 20px;
            gap: 10px;
        }

        #btn-save {
            background: #2659F5;
            color: #fff;
            padding: 8px 14px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        #btn-close {
            background: #ccc;
            padding: 8px 14px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        #removeImgBtn {
            margin-top: 10px;
            padding: 6px 10px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            background: #eee;
        }
    </style>
}

<div class="container">
    <div class="list-container">
        <div class="header">
            <h1>Danh sách danh mục</h1>
            <button class="btn-add" id="btnAdd" type="button">Thêm danh mục</button>
        </div>

        @if (TempData["ErrorMsg"] != null)
        {
            <div style="margin-bottom:12px;padding:10px;border:1px solid #f5c2c7;background:#f8d7da;color:#842029;border-radius:8px;">
                @TempData["ErrorMsg"]
            </div>
        }

        <table id="categoryTable" class="category-table display">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>ID</th>
                    <th>Tên danh mục</th>
                    <th>Hình ảnh</th>
                    <th>Trạng thái</th>
                    <th>Tùy chọn</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" style="text-align:center;padding:16px;">Không có danh mục</td>
                    </tr>
                }
                else
                {
                    foreach (var c in Model)
                    {
                        // ===== normalize thumbnail giống JSP =====
                        var thumb = c.Thumbnail ?? "";
                        var imgUrl = thumb;

                        // nếu DB/API trả "uploads/..." thiếu dấu "/" đầu -> thêm "/"
                        if (!string.IsNullOrWhiteSpace(imgUrl) &&
                        !imgUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) &&
                        !imgUrl.StartsWith("/"))
                        {
                            imgUrl = "/" + imgUrl;
                        }

                        <tr>
                            <td></td>
                            <td>@c.Id</td>
                            <td>@c.CategoryName</td>

                            <td class="col-thumb">
                                @if (!string.IsNullOrWhiteSpace(c.Thumbnail))
                                {
                                    <img class="thumb" src="@imgUrl" alt="category" />
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>

                            <td>
                                @if (c.IsActive == 1)
                                {
                                    <span class="badge-active">Đang dùng</span>
                                }
                                else
                                {
                                    <span class="badge-inactive">Đã khóa</span>
                                }
                            </td>

                            <td>
                                <!-- EDIT -->
                                <button type="button"
                                        class="btn-icon btn-edit btnEdit"
                                        data-id="@c.Id"
                                        data-name="@c.CategoryName"
                                        data-thumbnail="@imgUrl">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>

                                <!-- LOCK/UNLOCK -->
                                <form action="/admin/categories" method="post" style="display:inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="action" value="toggleActive" />
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <input type="hidden" name="isActive" value="@c.IsActive" />

                                    @{
                                        var isActive = c.IsActive == 1;
                                        var btnCls = isActive ? "btn-lock" : "btn-unlock";
                                        var title = isActive ? "Khóa danh mục" : "Mở khóa danh mục";
                                        var msg = isActive ? "Khóa danh mục này?" : "Mở khóa danh mục này?";
                                    }

                                    <button class="btn-icon @btnCls"
                                            type="submit"
                                            title="@title"
                                            onclick="return confirm('@msg')">
                                        @if (isActive)
                                        {
                                            <i class="fa-solid fa-lock"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-lock-open"></i>
                                        }
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ===== MODAL ADD/EDIT ===== -->
<div id="modal" class="modal">
    <div class="modal-content">
        <h2 id="modalTitle">Thêm danh mục</h2>

        <form id="categoryForm"
              action="/admin/categories"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input type="hidden" name="action" id="action" value="create" />
            <input type="hidden" name="id" id="dbId" value="" />

            <label>Tên danh mục</label>
            <input type="text" id="categoryName" name="categoryName" required />

            <label>Ảnh danh mục</label>
            <input type="file" id="thumbnail" name="thumbnail" accept="image/*" />

            <img id="previewImg" style="width:120px; display:none; margin-top:10px;" />
            <button type="button" id="removeImgBtn" style="display:none;">Xóa ảnh</button>

            <div class="modal-buttons">
                <button id="btn-save" type="submit">Lưu</button>
                <button id="btn-close" type="button">Hủy</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <!-- jQuery + DataTables (để chắc chắn chạy) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>

    <script>
        // ===== Modal controls =====
        const modal = document.getElementById("modal");
        const btnAdd = document.getElementById("btnAdd");
        const btnClose = document.getElementById("btn-close");
        const modalTitle = document.getElementById("modalTitle");
        const actionInput = document.getElementById("action");
        const dbId = document.getElementById("dbId");
        const nameInput = document.getElementById("categoryName");

        // preview
        const thumbnailInput = document.getElementById("thumbnail");
        const previewImg = document.getElementById("previewImg");
        const removeImgBtn = document.getElementById("removeImgBtn");

        function openModal(){ modal.style.display="flex"; }
        function closeModal(){ modal.style.display="none"; }

        btnAdd.addEventListener("click", () => {
            modalTitle.innerText = "Thêm danh mục";
            actionInput.value = "create";
            dbId.value = "";
            nameInput.value = "";

            thumbnailInput.value = "";
            previewImg.style.display = "none";
            removeImgBtn.style.display = "none";
            previewImg.src = "";

            openModal();
        });

        btnClose.addEventListener("click", closeModal);
        window.addEventListener("click", (e) => { if(e.target === modal) closeModal(); });

        thumbnailInput.addEventListener("change", function(){
            const file = this.files && this.files[0];
            if(file){
                previewImg.src = URL.createObjectURL(file);
                previewImg.style.display = "block";
                removeImgBtn.style.display = "inline-block";
            }
        });

        removeImgBtn.addEventListener("click", function(){
            thumbnailInput.value = "";
            previewImg.src = "";
            previewImg.style.display = "none";
            removeImgBtn.style.display = "none";
        });

        // ===== Edit button fill =====
        document.querySelectorAll(".btnEdit").forEach(btn => {
            btn.addEventListener("click", () => {
                modalTitle.innerText = "Cập nhật danh mục";
                actionInput.value = "update";

                dbId.value = btn.getAttribute("data-id") || "";
                nameInput.value = btn.getAttribute("data-name") || "";

                const thumb = btn.getAttribute("data-thumbnail") || "";
                if (thumb.trim() !== "" && !thumb.endsWith("/"))
                {
                    previewImg.src = thumb;
                    previewImg.style.display = "block";
                    removeImgBtn.style.display = "inline-block";
                }
                else
                {
                    previewImg.src = "";
                    previewImg.style.display = "none";
                    removeImgBtn.style.display = "none";
                }

                thumbnailInput.value = "";
                openModal();
            });
        });

        // ===== DataTables + Auto STT =====
        $(function () {
            const viUrl = "https://cdn.datatables.net/plug-ins/1.13.8/i18n/vi.json";

            const table = $("#categoryTable").DataTable({
                pageLength: 5,
                lengthChange: false,
                ordering: true,
                searching: true,
                info: false,
                language: { url: viUrl },
                columnDefs: [
                    { orderable: false, targets: [0, 3, 5] } // STT, thumb, actions
                ],
                order: [[1, "asc"]]
            });

            table.on("order.dt search.dt draw.dt", function () {
                const pageInfo = table.page.info();
                table.column(0, { search: "applied", order: "applied" }).nodes()
                    .each(function (cell, i) {
                        cell.innerHTML = pageInfo.start + i + 1;
                    });
            }).draw();
        });
    </script>
}
