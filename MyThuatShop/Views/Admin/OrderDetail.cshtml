@model MyThuatShop.Dtos.Orders.OrderDetailDto
@using MyThuatShop.Helpers

@{
    ViewData["Title"] = "Chi tiet don hang";
    ViewData["ActiveMenu"] = "orders";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var ApiBaseUrl = (ViewBag.ApiBaseUrl as string) ?? "https://localhost:7090";
}

@section Styles {
    <style>
        #main .right .container {
            width: calc(100% - 100px);
            margin: 20px auto;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .card {
            background: #fff;
            border-radius: 10px;
            padding: 18px 18px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .info-row {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
        }

        .info-col {
            flex: 1;
            min-width: 280px;
        }

        .info-item {
            margin-bottom: 10px;
        }

        .info-label {
            font-weight: 500;
            color: #374151;
        }

        .info-value {
            color: #6b7280;
        }

        .items-list {
            margin-top: 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .order-item {
            display: flex;
            gap: 14px;
            align-items: center;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 12px;
            background: #fafafa;
        }

        .order-item img {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #e5e7eb;
        }

        .item-info {
            flex: 1;
        }

        .item-name {
            font-weight: 600;
            color: #111827;
        }

        .item-qty {
            color: #6b7280;
            font-size: 14px;
        }

        .item-price {
            text-align: right;
        }

        .item-price .label {
            color: #6b7280;
            font-size: 13px;
        }

        .item-price .value {
            font-weight: 600;
            color: #111827;
        }

        .total-section {
            margin-top: 16px;
            padding-top: 16px;
            border-top: 1px solid #e5e7eb;
            text-align: right;
        }

        .total-row {
            margin-bottom: 6px;
        }

        .total-label {
            color: #6b7280;
        }

        .total-value {
            font-weight: 600;
            color: #111827;
            margin-left: 10px;
        }

        .total-final {
            font-size: 20px;
            font-weight: 600;
            color: #dc2626;
        }

        .btn-back {
            display: inline-block;
            padding: 10px 16px;
            border-radius: 8px;
            text-decoration: none;
            border: 1px solid #2659F3;
            color: #2659F3;
            font-weight: 600;
            background: #fff;
            transition: all 0.2s;
        }

        .btn-back:hover {
            background: #eff6ff;
        }

        .btn-back i {
            margin-right: 6px;
        }
    </style>
}

<div class="container">
    <a class="btn-back" href="/admin/orders">
        <i class="fa-solid fa-arrow-left"></i> Quay lai
    </a>

    <div class="card" style="margin-top: 14px;">
        <h2 style="margin: 0 0 16px 0; font-weight: 600;">Chi tiet don #DH@(Model.Id.ToString("D2"))</h2>

        <div class="info-row">
            <div class="info-col">
                <div class="info-item">
                    <span class="info-label">Khach hang:</span>
                    <span class="info-value">@Model.FullName</span>
                </div>
                <div class="info-item">
                    <span class="info-label">SDT:</span>
                    <span class="info-value">@(Model.PhoneNumber ?? "-")</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Email:</span>
                    <span class="info-value">@(Model.Email ?? "-")</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Dia chi:</span>
                    <span class="info-value">@(Model.Address ?? "-")</span>
                </div>
            </div>

            <div class="info-col" style="text-align: right;">
                <div class="info-item">
                    <span class="info-label">Ngay tao:</span>
                    <span class="info-value">@Model.CreateAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="info-item">
                    <span class="info-label">Thanh toan:</span>
                    <span class="info-value">@(Model.PaymentStatus ?? "-")</span>
                </div>
            </div>
        </div>

        <div class="items-list">
            <h3 style="margin: 0 0 10px 0; font-weight: 600;">San pham</h3>
            @foreach (var it in Model.Items ?? new())
            {
                var img = ImageUrlHelper.ToAbsolute(it.Thumbnail, ApiBaseUrl);
                if (string.IsNullOrWhiteSpace(img)) img = "https://placehold.co/70x70";

                <div class="order-item">
                    <img src="@img" alt="@it.ProductName" onerror="this.src='https://placehold.co/70x70'">
                    <div class="item-info">
                        <div class="item-name">@it.ProductName</div>
                        <div class="item-qty">SL: @it.Quantity</div>
                    </div>
                    <div class="item-price">
                        <div class="label">Gia</div>
                        <div class="value">@it.UnitPrice.ToString("N0") VND</div>
                    </div>
                </div>
            }
        </div>

        <div class="total-section">
            <div class="total-row">
                <span class="total-label">Phi ship:</span>
                <span class="total-value">@Model.ShippingFee.ToString("N0") VND</span>
            </div>
            <div class="total-row">
                <span class="total-label">Giam gia:</span>
                <span class="total-value">@((Model.Discount ?? 0m).ToString("N0")) VND</span>
            </div>
            <div class="total-row">
                <span class="total-label">Tong:</span>
                <span class="total-final">@Model.TotalPrice.ToString("N0") VND</span>
            </div>
        </div>
    </div>
</div>
