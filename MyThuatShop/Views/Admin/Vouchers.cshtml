    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const searchForm = document.getElementById("voucherSearchForm");
            const btnSearch = document.getElementById("btnSearch");
            const searchInput = document.getElementById("searchInput");
            const tbody = document.getElementById("vouchersTbody");
            const pagination = document.getElementById("vouchersPagination");

            if (!searchInput || !tbody || !pagination) return;

            const pageSize = @pageSize; // lấy đúng pageSize server
            let typingTimer = null;
            let abortCtrl = null;

            function getAntiForgeryToken() {
                return document.querySelector('#antiForgerySource input[name="__RequestVerificationToken"]')?.value || "";
            }

            async function loadVouchers(page = 1) {
                const keyword = (searchInput.value || "").trim();

                if (abortCtrl) abortCtrl.abort();
                abortCtrl = new AbortController();

                try {
                    const url = `/admin/vouchers/ajax?keyword=${encodeURIComponent(keyword)}&page=${page}&pageSize=${pageSize}`;
                    const res = await fetch(url, { signal: abortCtrl.signal });

                    if (!res.ok) return;

                    const data = await res.json();
                    renderTable(data);
                    renderPagination(data);
                } catch (err) {
                    if (err?.name !== "AbortError") console.error(err);
                }
            }

            // để bạn vẫn gọi được từ onclick nếu cần
            window.loadVouchers = loadVouchers;

            function renderTable(data) {
                const token = getAntiForgeryToken();
                const keyword = data.keyword || "";
                const page = data.page || 1;

                if (!data.items || data.items.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="8">Không có khuyến mãi nào.</td></tr>`;
                    return;
                }

                tbody.innerHTML = data.items.map((v, idx) => {
                    const stt = (page - 1) * pageSize + idx + 1;

                    return `
                    <tr data-id="${v.id}"
                        data-min="${v.minOrderValue}"
                        data-used="${v.quantityUsed}"
                        data-active="${v.isActive}"
                        data-qty="${v.quantity}">
                        <td>${stt}</td>
                        <td class="col-code">${escapeHtml(v.code)}</td>
                        <td class="col-name">${escapeHtml(v.name)}</td>
                        <td class="col-desc">${escapeHtml(v.description)}</td>
                        <td class="col-start" data-value="${v.startDate}">${v.startDate}</td>
                        <td class="col-end" data-value="${v.endDate}">${v.endDate}</td>
                        <td class="col-cash" data-value="${v.voucherCash}">${formatMoney(v.voucherCash)}đ</td>
                        <td>
                            <button class="btn-Sua" type="button">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>

                            <form action="/admin/vouchers" method="post" style="display:inline" class="deleteForm">
                                <input type="hidden" name="__RequestVerificationToken" value="${token}" />
                                <input type="hidden" name="action" value="delete" />
                                <input type="hidden" name="id" value="${v.id}" />

                                <input type="hidden" name="keyword" value="${escapeAttr(keyword)}" />
                                <input type="hidden" name="page" value="${page}" />
                                <input type="hidden" name="pageSize" value="${pageSize}" />

                                <input type="hidden" name="code" value="${escapeAttr(v.code)}" />
                                <input type="hidden" name="name" value="${escapeAttr(v.name)}" />
                                <input type="hidden" name="description" value="${escapeAttr(v.description)}" />
                                <input type="hidden" name="startDate" value="${v.startDate}" />
                                <input type="hidden" name="endDate" value="${v.endDate}" />
                                <input type="hidden" name="voucherCash" value="${v.voucherCash}" />
                                <input type="hidden" name="minOrderValue" value="${v.minOrderValue}" />
                                <input type="hidden" name="quantity" value="${v.quantity}" />
                                <input type="hidden" name="quantityUsed" value="${v.quantityUsed}" />
                                <input type="hidden" name="isActive" value="${v.isActive}" />

                                <button class="btn-Xoa" type="button">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>`;
                }).join("");
            }

            function renderPagination(data) {
                const page = data.page || 1;
                const totalPages = data.totalPages || 1;

                let html = "";
                if (page > 1) html += `<a href="#" class="page-link" data-page="${page - 1}">Trước</a>`;
                for (let p = 1; p <= totalPages; p++) {
                    html += `<a href="#" class="page-link ${p === page ? "active" : ""}" data-page="${p}">${p}</a>`;
                }
                if (page < totalPages) html += `<a href="#" class="page-link" data-page="${page + 1}">Sau</a>`;

                pagination.innerHTML = html;
            }

            pagination.addEventListener("click", (e) => {
                const a = e.target.closest("a.page-link");
                if (!a) return;
                e.preventDefault();
                loadVouchers(parseInt(a.dataset.page || "1", 10));
            });

            // ✅ Gõ là tìm (150ms)
            searchInput.addEventListener("input", () => {
                clearTimeout(typingTimer);
                typingTimer = setTimeout(() => loadVouchers(1), 150);
            });

            // click kính lúp
            btnSearch?.addEventListener("click", () => loadVouchers(1));

            // Enter trong input
            searchForm?.addEventListener("submit", (e) => {
                e.preventDefault();
                loadVouchers(1);
            });

            function escapeHtml(s) {
                return (s ?? "").toString()
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#39;");
            }
            function escapeAttr(s) { return escapeHtml(s); }
            function formatMoney(n) { return Number(n || 0).toLocaleString("vi-VN"); }
        });
    </script>


}
