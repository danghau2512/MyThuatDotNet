@using System.Globalization
@using System.Linq
@model MyThuatShop.ViewModels.CartPageVm

@{
    Layout = "_Layout";
    ViewData["Title"] = "Giỏ hàng";
    var vi = CultureInfo.GetCultureInfo("vi-VN");
}

@section Styles {
    <style>
        .container {
            width: 1200px;
            margin: auto;
        }

        .main {
            margin-top: 110px;
        }

        .breadcrumb {
            background: #DBE8FF;
            color: #17479d;
            font-weight: 500;
            font-size: 16px;
            padding: 12px 40px;
            border-bottom: 1px solid #e5e7eb;
            margin-top: 100px;
        }

        .grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
        }

        .card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 2px 16px rgba(0,0,0,.08);
            border: 1px solid #e5e7eb;
        }

        .card-body {
            padding: 22px 26px;
        }

        .card-title {
            margin: 0 0 6px;
            font-size: 28px;
            font-weight: 700;
            color: #111827;
        }

        .subtle {
            color: #282b30;
        }

        .divider {
            height: 1px;
            background: #969aa3;
            margin: 16px 0;
        }

        .cart-item-card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            box-shadow: 0 1px 6px rgba(0,0,0,.05);
            padding: 16px;
            margin-bottom: 16px;
            transition: box-shadow .2s ease;
        }

        .cart-list .item {
            padding: 8px 0;
        }

        .item-grid {
            display: grid;
            grid-template-columns: auto 80px 1fr auto auto;
            align-items: center;
            gap: 16px;
        }

        .thumb {
            width: 74px;
            height: 74px;
            border-radius: 8px;
            background: #f5f5f5;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border: 1px solid #eee;
        }

            .thumb img {
                max-width: 100%;
                max-height: 100%;
                object-fit: cover;
            }

        .product-info {
            flex: 1;
            min-width: 0;
        }

        .meta-title {
            font-weight: 700;
            color: #111827;
            margin-bottom: 4px;
            line-height: 1.35;
        }

        .muted {
            color: #6b7280;
            font-size: 14px;
        }

        .qty {
            display: inline-flex;
            align-items: center;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            overflow: hidden;
        }

        .qty-btn {
            width: 32px;
            height: 32px;
            border: none;
            background: #fff;
            border: 1px solid #e5e7eb;
            font-size: 16px;
            cursor: pointer;
            transition: all .2s;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .qty-btn:hover {
                background: #f3f4f6;
                border-color: #2659F3;
                color: #2659F3;
            }

        .qty input[type="number"] {
            width: 50px;
            height: 34px;
            text-align: center;
            border: none;
            font-weight: 600;
            outline: none;
        }

        .price {
            font-weight: 600;
            color: #ef4444;
            font-size: 18px;
            min-width: 120px;
            text-align: right;
        }

        .qty-wrap {
            position: relative;
            display: inline-block;
            margin-left: auto;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
        }

        .btn {
            width: 100%;
            border: none;
            border-radius: 8px;
            padding: 12px 14px;
            letter-spacing: .3px;
            background: #2659F3;
            color: #fff;
            cursor: pointer;
            margin-top: 8px;
            font-size: 1rem;
            font-weight: 600;
        }

        .summary {
            height: fit-content;
        }

        .tinh-tien {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: 600;
            font-size: 18px;
            margin: 10px 0;
        }

            .tinh-tien p {
                margin: 0;
                color: #111827;
            }

            .tinh-tien .thanh-tien {
                color: #ef4444;
                font-weight: 700;
                font-size: 18px;
            }

        .Xoa-sp {
            position: absolute;
            top: 0;
            right: 0;
            transform: translate(50%, -50%);
            width: 28px;
            height: 28px;
            border: none;
            border-radius: 50%;
            background: #111;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: 0 2px 8px rgba(0,0,0,.15);
            z-index: 2;
            text-decoration: none;
        }
    </style>
}

<div class="breadcrumb">Trang chủ / Giỏ hàng</div>

<div class="container">
    <div class="grid">

        <!-- LEFT: CART -->
        <div class="card">
            <div class="card-body">
                <h2 class="card-title">Giỏ hàng của bạn</h2>
                <p class="subtle">
                    Bạn đang có <span id="cart-total-quantity">@Model.TotalQuantity</span>
                    sản phẩm trong giỏ hàng
                </p>
                <div class="divider"></div>

                <form action="~/AddToCart?action=update" method="post">
                    <div class="cart-list">
                        @if (Model.CartItems == null || !Model.CartItems.Any())
                        {
                            <p>Giỏ hàng của bạn đang trống.</p>
                        }
                        else
                        {
                            foreach (var item in Model.CartItems)
                            {
                                // ✅ normalize thumbnail giống JSP
                                var cartThumbUrl = item.Thumbnail ?? "";
                                var thumbUrl = "";
                                if (!string.IsNullOrWhiteSpace(cartThumbUrl))
                                {
                                    if (cartThumbUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase))
                                        thumbUrl = cartThumbUrl;
                                    else if (cartThumbUrl.StartsWith("/"))
                                        thumbUrl = Url.Content("~" + cartThumbUrl);
                                    else
                                        thumbUrl = Url.Content("~/" + cartThumbUrl);
                                }

                                <div class="cart-item-card" id="cart-item-@item.ProductId">
                                    <div class="item">
                                        <div class="item-grid">
                                            <div class="select-product">
                                                <input type="checkbox" checked />
                                            </div>

                                            <div class="thumb">
                                                @if (!string.IsNullOrWhiteSpace(thumbUrl))
                                                {
                                                    <img src="@thumbUrl" alt="@item.Name" />
                                                }
                                            </div>

                                            <div class="product-info">
                                                <div class="meta-title">@item.Name</div>
                                                <div class="muted">Mã SP: @item.ProductId</div>
                                            </div>

                                            <div class="price">
                                                <span class="price-value" id="subtotal-@item.ProductId">
                                                    @((item.GetPriceAfterDiscount() * item.Quantity).ToString("N0", vi))₫
                                                </span>
                                            </div>

                                            <div class="qty-wrap">
                                                <!-- ✅ nút Xóa (giống JSP) -->
                                                <a class="Xoa-sp"
                                                   href="~/AddToCart?action=remove&productId=@item.ProductId"
                                                   aria-label="Xóa sản phẩm">
                                                    <i class="fa-solid fa-xmark"></i>
                                                </a>

                                                <input type="hidden" name="productId" value="@item.ProductId" />

                                                <div class="qty">
                                                    <button type="button"
                                                            class="qty-btn"
                                                            onclick="decreaseQty(@item.ProductId)">
                                                        <i class="fa-solid fa-minus"></i>
                                                    </button>

                                                    <input type="number"
                                                           name="quantity"
                                                           value="@item.Quantity"
                                                           min="1"
                                                           class="qty-input"
                                                           id="qty-@item.ProductId"
                                                           data-product-id="@item.ProductId"
                                                           readonly />

                                                    <button type="button"
                                                            class="qty-btn"
                                                            onclick="increaseQty(@item.ProductId)">
                                                        <i class="fa-solid fa-plus"></i>
                                                    </button>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </form>
            </div>
        </div>

        <!-- RIGHT: SUMMARY -->
        <div class="card summary">
            <div class="card-body">
                <div class="head">
                    <h3 style="margin:0;font-size:28px;font-weight:700">Thông tin đơn hàng</h3>
                </div>
                <div class="divider"></div>

                <div class="tinh-tien">
                    <p>Tổng tiền:</p>
                    <span class="thanh-tien" id="cart-total-amount">
                        @Model.TotalAmount.ToString("N0", vi)đ
                    </span>
                </div>

                <p class="muted">Phí vận chuyển sẽ được tính ở trang Thanh toán</p>
                <p class="muted">Mã giảm giá được nhập ở trang Thanh toán</p>

                <a href="~/checkout">
                    @if (Model.CartSize == 0)
                    {
                        <button class="btn" disabled>Đặt hàng</button>
                    }
                    else
                    {
                        <button class="btn">Đặt hàng</button>
                    }
                </a>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function increaseQty(productId) {
            const input = document.getElementById('qty-' + productId);
            let currentQty = parseInt(input.value, 10);
            if (isNaN(currentQty)) currentQty = 0;
            currentQty++;
            input.value = currentQty;
            updateCartItem(productId, currentQty);
        }

        function decreaseQty(productId) {
            const input = document.getElementById('qty-' + productId);
            let currentQty = parseInt(input.value, 10);
            if (isNaN(currentQty)) currentQty = 1;
            if (currentQty > 1) {
                currentQty--;
                input.value = currentQty;
                updateCartItem(productId, currentQty);
            }
        }

        function formatCurrency(value) {
            return new Intl.NumberFormat('vi-VN').format(value) + 'đ';
        }

        function setCartCountUI(count) {
            // badge header
            const cartIcon = document.getElementById('cartIcon');
            if (cartIcon) cartIcon.setAttribute('data-count', count);

            // total quantity in cart page
            const cartTotalQty = document.getElementById('cart-total-quantity');
            if (cartTotalQty) cartTotalQty.textContent = count;
        }

        function updateCartItem(productId, quantity) {
            const updateUrl = '/AddToCart?action=ajaxUpdate';
            const params =
                'productId=' + encodeURIComponent(productId) +
                '&quantity=' + encodeURIComponent(quantity);

            fetch(updateUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
                },
                body: params
            })
            .then(async (resp) => {
                const data = await resp.json().catch(() => null);
                return { ok: resp.ok, status: resp.status, data };
            })
            .then(({ ok, status, data }) => {
                // ✅ giống JSP: nếu fail thì dừng
                if (!data) {
                    console.error('Update cart failed (no json)');
                    return;
                }

                if (!ok || !data.success) {
                    console.error(data.message || 'Update cart failed');

                    // nếu server có trả cartCount thì vẫn update UI
                    if (typeof data.cartCount !== 'undefined') {
                        setCartCountUI(String(data.cartCount));
                    }

                    // ✅ Vì server có thể đã remove item (ngừng bán/hết hàng) -> reload để đồng bộ 100%
                    if (status === 404 || status === 400) {
                        alert(data.message || 'Sản phẩm không còn hợp lệ trong giỏ hàng');
                        window.location.reload();
                    }
                    return;
                }

                // cập nhật thành tiền từng dòng
                const subSpan = document.getElementById('subtotal-' + productId);
                if (subSpan) {
                    subSpan.textContent = formatCurrency(data.itemSubtotal);
                }

                // cập nhật tổng tiền
                const totalSpan = document.getElementById('cart-total-amount');
                if (totalSpan) {
                    totalSpan.textContent = formatCurrency(data.totalAmount);
                }

                // cập nhật badge + tổng số lượng
                setCartCountUI(String(data.cartCount));
            })
            .catch(err => console.error(err));
        }
    </script>
}
