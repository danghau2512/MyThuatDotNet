@model MyThuatShop.Dtos.Orders.OrderDetailDto
@using MyThuatShop.Helpers

@{
    ViewData["Title"] = $"Chi tiết đơn #DH0{Model.Id}";
    Layout = "_Layout";
    var ApiBaseUrl = (ViewBag.ApiBaseUrl as string) ?? "https://localhost:7090";
}

@section Styles {
    <style>
        .container {
            width: 1200px;
            margin: auto;
        }

        .box {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 20px;
        }

        .row {
            display: flex;
            justify-content: space-between;
            gap: 20px;
            flex-wrap: wrap;
        }

        .muted {
            color: #6b7280;
        }

        .items {
            margin-top: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .item {
            display: flex;
            gap: 14px;
            align-items: center;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            padding: 12px;
        }

            .item img {
                width: 70px;
                height: 70px;
                object-fit: cover;
                border-radius: 8px;
                border: 1px solid #e5e7eb;
            }

        .name {
            font-weight: 600;
        }

        .right {
            margin-left: auto;
            text-align: right;
        }

        .total {
            font-size: 18px;
            font-weight: 700;
            color: #dc2626;
        }

        .btn {
            display: inline-block;
            padding: 10px 14px;
            border-radius: 10px;
            text-decoration: none;
            border: 1px solid #2659F3;
            color: #2659F3;
            font-weight: 600;
        }

            .btn:hover {
                background: #eff6ff;
            }

        .label {
            font-weight: 600;
        }

        .price {
            font-weight: 700;
        }
    </style>
}

<div class="container" style="padding-top:20px; padding-bottom:20px;">
    <a class="btn" asp-controller="Order" asp-action="History">← Quay lại lịch sử</a>

    <div class="box" style="margin-top:14px;">
        <h2 style="margin:0 0 10px 0;">Chi tiết đơn #DH0@(Model.Id)</h2>

        <div class="row">
            <div>
                <div><span class="label">Khách:</span> @Model.FullName</div>
                <div><span class="label">SĐT:</span> <span class="muted">@Model.PhoneNumber</span></div>
                <div><span class="label">Email:</span> <span class="muted">@Model.Email</span></div>
                <div><span class="label">Địa chỉ:</span> <span class="muted">@Model.Address</span></div>
            </div>

            <div class="right">
                <div><span class="label">Ngày tạo:</span> <span class="muted">@Model.CreateAt.ToString("dd/MM/yyyy HH:mm")</span></div>
                <div><span class="label">Trạng thái thanh toán:</span> <span class="muted">@Model.PaymentStatus</span></div>
                <div style="margin-top:10px;">
                    <div><span class="label">Phí ship:</span> @Model.ShippingFee.ToString("N0")₫</div>
                    <div><span class="label">Giảm giá:</span> @( (Model.Discount ?? 0m).ToString("N0") )₫</div>
                    <div class="total">Tổng: @Model.TotalPrice.ToString("N0")₫</div>
                </div>
            </div>
        </div>

        <div class="items">
            @foreach (var it in Model.Items ?? new())
            {
                var img = ImageUrlHelper.ToAbsolute(it.Thumbnail, ApiBaseUrl);
                if (string.IsNullOrWhiteSpace(img)) img = "https://placehold.co/80x80";

                <div class="item">
                    <img src="@img" alt="@it.ProductName" onerror="this.src='https://placehold.co/80x80'">
                    <div>
                        <div class="name">@it.ProductName</div>
                        <div class="muted">Số lượng: @it.Quantity</div>
                    </div>
                    <div class="right">
                        <div class="muted">Đơn giá</div>
                        <div class="price">@it.UnitPrice.ToString("N0")₫</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
