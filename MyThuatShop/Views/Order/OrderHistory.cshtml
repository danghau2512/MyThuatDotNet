@model MyThuatShop.ViewModels.Order.OrderHistoryPageVm
@using MyThuatShop.Helpers

@{
    ViewData["Title"] = "Lịch sử mua hàng";
    Layout = "_Layout";

    var fullName = (Model.FullName ?? "").Trim();
    var firstChar = string.IsNullOrWhiteSpace(fullName) ? "U" : fullName.Substring(0, 1);
    var st = (Model.CurrentStatus ?? "all").Trim().ToLowerInvariant();
    var ApiBaseUrl = (ViewBag.ApiBaseUrl as string) ?? "https://localhost:7090";
}

@section Styles {
    <style>
        .container {
            width: 1200px;
            margin: auto;
        }

        #section-trangchinh-danhmuc-sanpham {
            background-color: #DBE8FF;
        }

            #section-trangchinh-danhmuc-sanpham .content {
                padding: 20px 0;
                margin-bottom: 30px;
            }

                #section-trangchinh-danhmuc-sanpham .content a {
                    text-decoration: none;
                    color: black;
                }

                    #section-trangchinh-danhmuc-sanpham .content a:nth-child(2) {
                        color: #17479D;
                    }

        .section-main-ca-nhan {
            padding-bottom: 20px;
            padding-top: 20px;
        }

            .section-main-ca-nhan .container {
                padding: 20px;
                border: 1px solid #ddd;
                border-radius: 10px;
            }

                .section-main-ca-nhan .container .canhan {
                    display: flex;
                    gap: 30px;
                }

                .section-main-ca-nhan .container .tongquan-canhan {
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                    gap: 15px;
                    background-color: #F1F1F1;
                    border-radius: 10px;
                    width: 30%;
                    padding: 10px;
                    height: fit-content;
                }

                    .section-main-ca-nhan .container .tongquan-canhan .logo-name {
                        width: 80px;
                        height: 80px;
                        background-color: #FB9F10;
                        border-radius: 50%;
                        color: white;
                        font-size: 36px;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        font-weight: 700;
                        margin-top: 20px;
                    }

                    .section-main-ca-nhan .container .tongquan-canhan .name-full {
                        font-size: 18px;
                        font-style: italic;
                    }

                        .section-main-ca-nhan .container .tongquan-canhan .name-full .span {
                            color: #2659F3;
                            font-weight: 600;
                        }

                    .section-main-ca-nhan .container .tongquan-canhan .list-canhan {
                        display: flex;
                        flex-direction: column;
                        width: 100%;
                        align-items: center;
                        justify-content: center;
                    }

                        .section-main-ca-nhan .container .tongquan-canhan .list-canhan a {
                            width: calc(100% - 30px);
                            display: block;
                            padding: 15px;
                            background-color: #2659F3;
                            text-decoration: none;
                            color: white;
                            font-size: 18px;
                            font-weight: 600;
                        }

                            .section-main-ca-nhan .container .tongquan-canhan .list-canhan a:first-child {
                                border-top-left-radius: 10px;
                                border-top-right-radius: 10px;
                            }

                            .section-main-ca-nhan .container .tongquan-canhan .list-canhan a:last-child {
                                border-bottom-left-radius: 10px;
                                border-bottom-right-radius: 10px;
                            }

                            .section-main-ca-nhan .container .tongquan-canhan .list-canhan a:hover {
                                background-color: #FB9F10;
                                transition: all .4s;
                            }

                            .section-main-ca-nhan .container .tongquan-canhan .list-canhan a.active {
                                background-color: #FB9F10 !important;
                            }

        /* ===== Order history (copy style từ JSP) ===== */
        .order-history {
            flex: 1;
            background: #fff;
            padding: 24px;
            border-radius: 12px;
            box-shadow: 0 1px 3px rgba(0,0,0,.1);
            border: 1px solid #e5e7eb;
            overflow: hidden;
            font-size: 16px;
        }

        .order-tabs {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
        }

            .order-tabs a {
                flex: 1;
                text-decoration: none;
            }

            .order-tabs button {
                width: 100%;
                background: #f1f5ff;
                border: none;
                border-radius: 8px;
                padding: 10px;
                font-weight: 600;
                cursor: pointer;
                color: #2659F3;
                transition: .3s;
            }

                .order-tabs button.active, .order-tabs button:hover {
                    background: linear-gradient(135deg,#2659F3 0%,#1e40af 100%);
                    color: #fff;
                }

        .order-card {
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            margin-bottom: 25px;
            overflow: hidden;
        }

        .order-header {
            background: #f9fafb;
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            border-bottom: 1px solid #e5e7eb;
            font-weight: 600;
        }

        .order-status {
            padding: 4px 12px;
            border-radius: 20px;
            font-size: .9rem;
        }

            .order-status.pending {
                background: #fff3cd;
                color: #856404;
            }

            .order-status.success {
                background: #d1fae5;
                color: #065f46;
            }

            .order-status.canceled, .order-status.cancelled {
                background: #fee2e2;
                color: #991b1b;
            }

            .order-status.shipping {
                background: #e0f2fe;
                color: #075985;
            }

        .order-items {
            padding: 15px 20px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .order-item {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 12px 0;
        }

            .order-item img {
                width: 80px;
                height: 80px;
                border-radius: 8px;
                object-fit: cover;
                border: 1px solid #e5e7eb;
                flex-shrink: 0;
            }

        .order-info {
            flex: 1;
        }

        .order-name {
            font-size: 17px;
            font-weight: 600;
            color: #111827;
            margin: 0;
        }

        .order-quantity {
            color: #6b7280;
            margin: 4px 0 0;
            font-size: 15px;
        }

        .order-price {
            text-align: right;
        }

            .order-price p {
                color: #6b7280;
                margin: 0;
                font-size: 15px;
            }

            .order-price strong {
                color: #dc2626;
                font-size: 17px;
                font-weight: 700;
            }

        .order-footer {
            background: #f9fafb;
            padding: 12px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .total {
            font-size: 20px;
            color: #ef4444;
        }

        .order-buttons {
            display: flex;
            gap: 8px;
        }

            .order-buttons .btn-review {
                display: inline-block;
                padding: 8px 16px;
                border-radius: 8px;
                cursor: pointer;
                transition: .3s;
                font-weight: 600;
                text-decoration: none;
                border: 1px solid #2659F3;
                background: #fff;
                color: #2659F3;
            }

                .order-buttons .btn-review:hover {
                    background: #eff6ff;
                }
    </style>
}

<!-- breadcrumb -->
<div id="section-trangchinh-danhmuc-sanpham">
    <div class="container">
        <div class="content">
            <a asp-controller="Home" asp-action="Index">Trang chủ /</a>
            <a asp-controller="Account" asp-action="Profile">Tài khoản</a>
        </div>
    </div>
</div>

<div class="section-main-ca-nhan">
    <div class="container">
        <div class="canhan">

            <!-- Sidebar -->
            <div class="tongquan-canhan">
                <div class="logo-name">@firstChar</div>

                <p class="name-full">
                    Xin chào, <span class="span">@fullName</span>
                </p>

                <div class="list-canhan">
                    <a asp-controller="Account" asp-action="Profile">
                        <i class="fa-solid fa-user"></i> Thông tin tài khoản
                    </a>

                    <a asp-controller="Order" asp-action="History" class="active">
                        <i class="fa-solid fa-box-open"></i> Lịch sử mua hàng
                    </a>

                    <a asp-controller="Account" asp-action="ChangePassword">
                        <i class="fa-solid fa-rotate"></i> Đổi mật khẩu
                    </a>

                    <a href="javascript:void(0)" onclick="document.getElementById('logoutFormSidebar').submit();">
                        <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
                    </a>

                    <form id="logoutFormSidebar" asp-controller="Account" asp-action="Logout" method="post" style="display:none;">
                        @Html.AntiForgeryToken()
                    </form>
                </div>
            </div>

            <!-- Order History -->
            <div class="order-history">
                <div class="order-tabs">
                    <a asp-controller="Order" asp-action="History" asp-route-status="all">
                        <button class="@(st == "all" ? "active" : "")">Tất cả</button>
                    </a>
                    <a asp-controller="Order" asp-action="History" asp-route-status="pending">
                        <button class="@(st == "pending" ? "active" : "")">Chờ xác nhận</button>
                    </a>
                    <a asp-controller="Order" asp-action="History" asp-route-status="shipping">
                        <button class="@(st == "shipping" ? "active" : "")">Đang vận chuyển</button>
                    </a>
                    <a asp-controller="Order" asp-action="History" asp-route-status="completed">
                        <button class="@(st == "completed" ? "active" : "")">Hoàn thành</button>
                    </a>
                    <a asp-controller="Order" asp-action="History" asp-route-status="cancelled">
                        <button class="@(st == "cancelled" ? "active" : "")">Đã hủy</button>
                    </a>
                </div>

                @if (Model.Orders == null || Model.Orders.Count == 0)
                {
                    <p>Bạn chưa có đơn hàng nào.</p>
                }
                else
                {
                    foreach (var order in Model.Orders)
                    {
                        var statusClass = order.StatusId switch
                        {
                            1 => "pending",
                            2 => "shipping",
                            3 => "success",
                            4 => "canceled",
                            _ => "pending"
                        };

                        <div class="order-card">
                            <div class="order-header">
                                <span>Mã đơn: #DH@(order.Id.ToString("D2"))</span>
                                <span class="order-status @statusClass">@order.StatusName</span>
                            </div>

                            <div class="order-items">
                                @foreach (var item in order.Items ?? new())
                                {
                                    var img = ImageUrlHelper.ToAbsolute(item.Thumbnail, ApiBaseUrl);
                                    if (string.IsNullOrWhiteSpace(img)) img = "https://placehold.co/80x80";

                                    <div class="order-item">
                                        <img src="@img" alt="@item.ProductName" onerror="this.src='https://placehold.co/80x80'">
                                        <div class="order-info">
                                            <p class="order-name">@item.ProductName</p>
                                            <p class="order-quantity">Số lượng: @item.Quantity</p>
                                        </div>
                                        <div class="order-price">
                                            <p>@item.UnitPrice.ToString("N0")₫</p>
                                            <strong>@item.LineTotal.ToString("N0")₫</strong>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="order-footer">
                                <span class="total">
                                    Tổng cộng: <strong>@order.TotalPrice.ToString("N0")₫</strong>
                                </span>

                                <div class="order-buttons">
                                    <a class="btn-review" asp-controller="Order" asp-action="Detail" asp-route-id="@order.Id">
                                        Xem chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

        </div>
    </div>
</div>
