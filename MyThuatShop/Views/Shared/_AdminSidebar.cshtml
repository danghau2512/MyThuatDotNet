    <a class="@IsActive("orders")" href="/admin/orders">Đơn hàng</a>
    <a class="@IsActive("contacts")" href="/admin/contacts">Liên hệ</a>
    <a class="@IsActive("sliders")" href="/admin/sliders">Slider</a>
    <a class="@IsActive("vouchers")" href="/admin/vouchers">Voucher</a>
    <a class="@IsActive("statistics")" href="/admin/statistics">Thống kê</a>
</div>
