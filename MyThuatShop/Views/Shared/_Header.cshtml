<header id="header-trang-chu" class="trang-chu">
    <div class="logo-trang-chu">
        <a href>
            <img src="~/images/logo/logo.png">

        </a>
    </div>
    <form class="tim-kiem-san-pham" asp-controller="Product" asp-action="Search" method="get">
        <input type="text" name="q" placeholder="Tìm kiếm sản phẩm..." />
        <button type="submit" class="btn-search" aria-label="Tìm kiếm">
            <i class="fa-solid fa-magnifying-glass"></i>
        </button>
    </form>

    <div class="header-contact">
        <i class="fa-solid fa-phone"></i>
        <div class="contact">
            <div class="contact-phone-number">1900 866 819</div>
            <div class="contact-phone-help">Hỗ trợ khách hàng</div>
        </div>
    </div>
    <div class="header-dangnhap-dangki">
        <i class="fa-solid fa-user"></i>

        <div class="dangnhap-dangki">
            @{
                var fullName = Context.Session.GetString("FullName");
            }

            @if (!string.IsNullOrEmpty(fullName))
            {
                <div class="dangnhap">Hi, @fullName</div>

                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0;">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="dangki"
                            style="background:none;border:none;color:white;padding:0;cursor:pointer;">
                        Đăng xuất
                    </button>
                </form>
            }
            else
            {
                <div class="dangnhap">
                    <a class="dangnhap" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    <br />
                    <a class="dangki" asp-controller="Account" asp-action="Register">Đăng ký</a>
                </div>
            }
        </div>
    </div>
    <div class="header-giohang">
        <a class href="Cart.html">
            <i class="fa-solid fa-bag-shopping"></i>
        </a>

    </div>
</header>