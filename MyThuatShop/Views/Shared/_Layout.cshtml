<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
          crossorigin="anonymous" referrerpolicy="no-referrer" />

    @RenderSection("Styles", required: false)
</head>
<body>
    @await Html.PartialAsync("_Header")

    <main class="main-content">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_Footer")

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Search suggest global -->
    <script>
        $(function () {
            let timer = null;

            function hideSuggest() {
                $("#suggestBox").hide();
                $("#suggestList").empty();
            }

            $(document).on("keyup", "#searchBox", function (e) {
                const keyword = $(this).val().trim();
                clearTimeout(timer);

                if (e.key === "Enter") return;
                if (keyword.length < 2) { hideSuggest(); return; }

                timer = setTimeout(function () {
                    $.ajax({
                        url: "/Search/Suggest",
                        method: "GET",
                        data: { keyword: keyword, take: 8 },
                        success: function (data) {
                            if (!data || data.length === 0) { hideSuggest(); return; }

                            const $list = $("#suggestList");
                            $list.empty();

                            for (let i = 0; i < data.length; i++) {
                                const item = data[i];
                                const detailUrl = "/Product/Detail/" + item.id;
                                const thumb = item.thumbnailUrl || '';

                                const li =
                                    '<li>' +
                                    '<a href="' + detailUrl + '">' +
                                    (thumb ? '<img src="' + thumb + '" alt="' + item.name + '">' : '') +
                                    '<div>' +
                                    '<div class="suggest-name">' + item.name + '</div>' +
                                    '<div class="suggest-price">' + Number(item.price).toLocaleString('vi-VN') + ' đ</div>' +
                                    '</div>' +
                                    '</a>' +
                                    '</li>';

                                $list.append(li);
                            }

                            $("#suggestBox").show();
                        },
                        error: function () {
                            hideSuggest();
                        }
                    });
                }, 250);
            });

            $(document).on("click", function (e) {
                if (!$(e.target).closest(".search-wrapper").length) hideSuggest();
            });
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
